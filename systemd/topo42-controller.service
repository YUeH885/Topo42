[Unit]
Description=Topo42 Controller
After=network.target

[Service]
ExecStart=/usr/bin/topo42-controller --host 0.0.0.0 --port 8000 --agent-token change-me
Restart=on-failure
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
